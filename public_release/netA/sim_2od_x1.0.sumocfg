<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="network_v2.net.xml" />
    <route-files value="demand_2od_x1.0.trips.xml" />
  </input>
  <time>
    <begin value="0" />
    <end value="4200" />
  </time>
  <report>
    <no-step-log value="true" />
    <duration-log.disable value="true" />
  </report>
  <output>
    <tripinfo-output value="tripinfo.xml" />
  </output>
</configuration>