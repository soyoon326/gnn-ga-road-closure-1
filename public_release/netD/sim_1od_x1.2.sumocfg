<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="netD.net.xml"/>

        <route-files value="demand_1od_x1.2.trips.xml"/>

    </input>

    <time>
    </time>

    <report>
        <no-step-log value="true"/>
    </report>

    <output>
        <tripinfo-output value="tripinfo_netD.xml"/>
    </output>

</configuration>
